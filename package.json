{
  "name": "@nairaramp/react",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nairaramp/core": "^0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@nairaramp/core": "0.1.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "26.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "9.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
